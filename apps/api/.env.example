# MehrWearingShopping — API environment (copy to apps/api/.env)

# --- HTTP -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of this API (used for payment gateway callbacks + OpenAPI server)
API_BASE_URL=http://localhost:4000
# Public URL of the storefront (used for post-payment redirects)
WEB_BASE_URL=http://localhost:3000
# Comma separated list of allowed browser origins for direct API access
CORS_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local default points at the embedded PostgreSQL started by `bun run db:start`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/mehrwearing
# Used only by the e2e suite when it provisions its own throwaway database
# DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5434/mehrwearing_test

# --- Auth -------------------------------------------------------------------
# CHANGE THESE in production (long, random values). Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Shipping ---------------------------------------------------------------
SHIPPING_STANDARD_COST=35000
SHIPPING_EXPRESS_COST=89000
FREE_SHIPPING_THRESHOLD=1500000

# --- Payments ---------------------------------------------------------------
# mock  = built-in fake gateway for development & demos (no credentials)
# zarinpal = production Iranian gateway (requires ZARINPAL_MERCHANT_ID)
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/v1/payments/zarinpal/callback

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@mehrwearing.ir
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
