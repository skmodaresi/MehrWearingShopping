# MehrWearingShopping — mobile (Expo) environment
# Copy to apps/mobile/.env and point at the API you want to hit.
# EXPO_PUBLIC_* values are inlined at build time and are PUBLIC — never put
# secrets here (the app only ever carries its own access token).

# Android emulators reach the host machine via 10.0.2.2, not localhost.
#   iOS simulator / web: http://localhost:4000/api/v1
#   Android emulator:    http://10.0.2.2:4000/api/v1
#   Physical device:     http://<your-lan-ip>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
